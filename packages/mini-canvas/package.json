{
  "name": "@fazelstudio/mini-canvas",
  "version": "0.1.0",
  "description": "A small, dependency-free 2D canvas renderer powered by Rust and WebAssembly.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fazelstudio/mini-canvas"
  },
  "keywords": ["canvas", "png", "wasm", "rust", "drawing"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "wasm", "LICENSE", "NOTICE", "THIRD-PARTY-LICENSES.md", "README.md"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun ../../scripts/build.mjs",
    "test": "bun test",
    "test:update": "bun test && bun ../../benchmarks/bench.mjs --update",
    "pack:check": "bun pm pack --dry-run"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.3"
  }
}
